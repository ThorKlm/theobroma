<div id="cladogram-panel" style="display:none;margin:1rem 0 1.5rem 0;">
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.4rem;">
      <div>
        <div style="font-size:0.85rem;color:var(--text-muted);">Linear cladogram</div>
        <div style="font-size:1.1rem;font-weight:600;color:var(--text-strong);margin-top:0.1rem;">Compounds by taxonomic hierarchy</div>
      </div>
      <div style="text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:0.25rem;">
        <a href="#" id="cladogram-close" style="font-size:0.8rem;color:var(--accent);text-decoration:none;">[ close ]</a>
        <div id="cladogram-query-list" style="font-size:0.78rem;color:var(--text-muted);font-family:monospace;line-height:1.35;text-align:right;"></div>
      </div>
    </div>
    <div id="cladogram-container" style="width:100%;overflow-x:auto;overflow-y:visible;"></div>
    <div id="cladogram-loading" style="text-align:center;padding:2rem;color:var(--text-muted);display:none;">Loading cladogram...</div>
    <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.78rem;color:var(--text-muted);margin-top:0.6rem;">
      <div>Hover any node for detail. Click a clade to search compounds at that rank. Use the controls below to toggle compounds, adjust font, or export.</div>
      <div>THEOBROMA {{ theobroma_version }}</div>
    </div>
    <div id="cladogram-tip" style="position:fixed;display:none;background:white;border:1px solid var(--border);padding:0.3rem 0.5rem;font-size:0.85rem;pointer-events:none;z-index:1000;box-shadow:0 2px 6px rgba(0,0,0,0.1);border-radius:3px;"></div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/d3@7" defer></script>
<script>
(function(){
  var loaded = false, data = null, expanded = false;
  var wrap = document.querySelector('.linear-tree-thumb-wrap');
  var panel = document.getElementById('cladogram-panel');
  var closeBtn = document.getElementById('cladogram-close');
  if (!wrap || !panel) return;

  function toggle(e){
    if (e) e.preventDefault();
    expanded = !expanded;
    panel.style.display = expanded ? '' : 'none';
    if (expanded && !loaded) loadAndRender();
  }
  wrap.addEventListener('click', toggle);
  closeBtn.addEventListener('click', toggle);

  // Populate query-list (mirrors taxonomy_expand)
  var qs = window.location.search.replace(/^\?/, '');
  var ql = document.getElementById('cladogram-query-list');
  if (qs && ql) {
    var parts = qs.split('&').filter(function(p){
      var k = p.split('=')[0];
      return p && k !== 'page' && k !== 'sort' && k !== 'order' && k !== 'per_page';
    });
    if (parts.length > 0) {
      ql.innerHTML = parts.map(function(p){
        var kv = p.split('=');
        return kv[0] + ': ' + decodeURIComponent((kv[1] || '').replace(/\+/g, ' '));
      }).join('<br>');
    }
  }

  function loadAndRender(){
    document.getElementById('cladogram-loading').style.display = '';
    fetch('/api/taxonomy_tree' + window.location.search)
      .then(function(r){return r.json();})
      .then(function(d){
        data = d;
        loaded = true;
        document.getElementById('cladogram-loading').style.display = 'none';
        render();
      })
      .catch(function(err){
        document.getElementById('cladogram-loading').textContent = 'Failed: ' + err;
      });
  }

  // Rank order from kingdom (root) outward
  var RANK_DEPTH = ['root','kingdom','phylum','class','order','family','genus','compound'];
  var KINGDOM_COLORS = {
    'plant':'#2e7d32','fungi':'#9b59b6','bacteria':'#3498db',
    'animal':'#e67e22','unresolved':'#7f8c8d','marine':'#16a085'
  };

  function kingdomOf(node){
    // walk up to depth 1 (the kingdom-level child of root)
    var n = node;
    while (n.depth > 1 && n.parent) n = n.parent;
    return (n.data && n.data.name) || 'plant';
  }

  // Strip "(unresolved)" branches and apply per-depth caps.
  // depth 0=root, 1=kingdom, 2=phylum, 3=class, 4=order, 5=family, 6=genus.
  function pruneWithCaps(node, depth, caps){
    if (!node.children) return;
    node.children = node.children.filter(function(c){ return c.name !== '(unresolved)'; });
    var cap = caps[depth + 1];  // cap on this node's children
    if (cap !== undefined && node.children.length > cap){
      node.children.sort(function(a,b){return b.value - a.value;});
      node.children = node.children.slice(0, cap);
    }
    node.children.forEach(function(c){ pruneWithCaps(c, depth + 1, caps); });
  }

  function countLeaves(node, depth){
    if (!node.children || node.children.length === 0) return 1;
    var n = 0;
    node.children.forEach(function(c){ n += countLeaves(c, depth + 1); });
    return n;
  }

  // caps_sequence: each entry is [kingdom_cap, phylum_cap, class_cap, order_cap, family_cap, genus_cap]
  // (indices 1..6 used in pruneWithCaps; index 0 is ignored).
  // Each tuple: [unused, kingdom, phylum, class, order, family, genus, compound].
  // compound_cap = 0 means compound-rank is hidden entirely. >0 means show that
  // many compounds per genus.
  var CAPS_SEQUENCE = [
    [0, 5, 3,  3,  3,  3,  3,  0],
    [0, 5, 3,  3,  3,  3,  5,  0],
    [0, 5, 3,  3,  3,  5,  5,  0],
    [0, 5, 3,  3,  3,  5, 10,  0],
    [0, 5, 3,  3,  5,  5, 10,  0],
    [0, 5, 3,  5,  5,  5, 10,  0],
    [0, 5, 5,  5,  5,  5, 10,  0],
    [0, 5, 5,  5,  5, 10, 10,  0],
    [0, 5, 5,  5,  5, 10, 20,  0],
    [0, 5, 5,  5, 10, 10, 20,  0],
    [0, 5, 5, 10, 10, 10, 20,  0],
    [0, 5,10, 10, 10, 10, 20,  0],
    [0, 5,10, 10, 10, 20, 20,  0],
    [0, 5,20, 20, 20, 20, 20,  0],
    [0, 5,50, 50, 50, 50, 50,  0],
    [0, 5, 999, 999, 999, 999, 999, 0]
  ];
  // Three-mode compound visibility: 0=hidden, 1=cap 100 per genus, 2=all
  var COMPOUND_MODES = [
    {idx: 0, cap: 0,   label_next: 'Show compounds (cap 100/genus)'},
    {idx: 1, cap: 100, label_next: 'Show all compounds'},
    {idx: 2, cap: 999, label_next: 'Hide compounds'}
  ];
  var compoundMode = 0;
  // Font multiplier for clade labels (not compound names). Range 0.6..1.6.
  var fontMul = 1.0;
  var TARGET_LEAVES_MIN = 100, TARGET_LEAVES_MAX = 250;

  // Find caps that produce >= TARGET_LEAVES_MIN leaves while keeping <= TARGET_LEAVES_MAX.
  // Returns the index in CAPS_SEQUENCE.
  function pickCapsIndex(treeOrig){
    for (var i = 0; i < CAPS_SEQUENCE.length; i++){
      var trial = JSON.parse(JSON.stringify(treeOrig));
      pruneWithCaps(trial, 0, CAPS_SEQUENCE[i]);
      var n = countLeaves(trial, 0);
      if (n >= TARGET_LEAVES_MIN){
        // If this index pushed too far, back off one
        if (n > TARGET_LEAVES_MAX && i > 0){
          var prev = JSON.parse(JSON.stringify(treeOrig));
          pruneWithCaps(prev, 0, CAPS_SEQUENCE[i - 1]);
          if (countLeaves(prev, 0) >= 50) return i - 1;
        }
        return i;
      }
    }
    return CAPS_SEQUENCE.length - 1;
  }

  var currentCapsIdx = 0;
  var originalTreeData = null;

  function applyCapsAndRerender(){
    var treeData = JSON.parse(JSON.stringify(originalTreeData));
    var caps = CAPS_SEQUENCE[currentCapsIdx].slice();
    caps[7] = COMPOUND_MODES[compoundMode].cap;
    pruneWithCaps(treeData, 0, caps);
    renderTree(treeData);
  }

  function render(){
    var c = document.getElementById('cladogram-container');
    c.innerHTML = '';
    if (!data || !data.tree || !data.tree.children || data.tree.children.length === 0){
      c.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);">No taxonomic data to display for this filter.</div>';
      return;
    }

    // Cut at compound rank (depth 7). Genera at depth 6, compounds at depth 7.
    function cutAtCompound(node, depth){
      if (depth >= 7 && node.children) {
        delete node.children;
      } else if (node.children) {
        node.children.forEach(function(c){ cutAtCompound(c, depth+1); });
      }
    }

    // Save original tree (compounds preserved), pick initial caps level
    originalTreeData = JSON.parse(JSON.stringify(data.tree));
    cutAtCompound(originalTreeData, 0);
    currentCapsIdx = pickCapsIndex(originalTreeData);

    applyCapsAndRerender();
  }

  function renderTree(treeData){
    var c = document.getElementById('cladogram-container');
    c.innerHTML = '';
    var root = d3.hierarchy(treeData);

    // Pre-compute terminal (leaf) count to size the SVG height
    var nLeaves = root.leaves().length;
    var rowHeight = 22;
    var topMargin = 30;
    var height = Math.max(400, nLeaves * rowHeight + topMargin * 2);

    // Fixed x positions per rank (kingdom through genus), with extra width for terminal labels.
    var rankX = [40, 140, 260, 380, 500, 640, 760, 920];
    var width = rankX[7] + 240;

    // Manual layout: each leaf gets its own row, internal nodes are centered on
    // the average y of their leaf descendants. This guarantees connector lines
    // are visible because no parent and child share the same y unless the parent
    // has exactly one descendant chain.
    var leafIdx = 0;
    var leaves = root.leaves();
    leaves.forEach(function(leaf){
      leaf.x_orig = topMargin + leafIdx * rowHeight;
      leafIdx++;
    });

    // For internal nodes, post-order traversal to compute mean leaf-y
    function setInternal(node){
      if (!node.children || node.children.length === 0) return;
      node.children.forEach(setInternal);
      var sum = 0, n = 0;
      node.leaves().forEach(function(l){ sum += l.x_orig; n++; });
      node.x_orig = sum / n;
    }
    setInternal(root);

    // Assign fixed x positions per rank
    root.descendants().forEach(function(d){
      d.fixed_x = rankX[Math.min(d.depth, 7)];
    });

    // Reserve space at top for title (40px) and bottom for footer (20px)
    var titleH = 50;
    var footerH = 20;
    var svgWidth = width;
    var svgHeight = height + titleH + footerH;
    var svg = d3.select(c).append('svg')
      .attr('width', svgWidth).attr('height', svgHeight)
      .attr('xmlns', 'http://www.w3.org/2000/svg')
      .attr('viewBox', '0 0 ' + svgWidth + ' ' + svgHeight)
      .style('font','12px sans-serif')
      .style('background','white');

    // Title block (top-left)
    svg.append('text')
      .attr('x', 12).attr('y', 18)
      .attr('font-size', '12px').attr('fill', '#888')
      .text('Linear cladogram');
    svg.append('text')
      .attr('x', 12).attr('y', 36)
      .attr('font-size', '16px').attr('font-weight', '600').attr('fill', '#2c3e50')
      .text('Compounds by taxonomic hierarchy');

    // Footer (bottom-left): database version
    svg.append('text')
      .attr('x', 12).attr('y', svgHeight - 6)
      .attr('font-size', '10px').attr('fill', '#999')
      .text('THEOBROMA {{ theobroma_version }}');

    // Main render group is shifted down past the title
    var g = svg.append('g').attr('transform', 'translate(0,' + titleH + ')');

    // Cubic Bezier with horizontal tangents at both endpoints (slope=0 at both ends).
    // Control points share each endpoint's y, placed halfway along the x-span,
    // giving a smooth S-shaped curve (equivalent to cubic Hermite with zero tangents).
    var diagonal = function(s, t){
      var midX = (s.fixed_x + t.fixed_x) / 2;
      return 'M ' + s.fixed_x + ',' + s.x_orig +
             ' C ' + midX + ',' + s.x_orig + ' ' +
             midX + ',' + t.x_orig + ' ' +
             t.fixed_x + ',' + t.x_orig;
    };

    var debugLines = ['<!-- cladogram debug:'];
    debugLines.push('  links: ' + root.links().length);
    root.links().forEach(function(l, i){
      if (i < 5) debugLines.push('  link ' + i + ': source(' + l.source.fixed_x + ',' + l.source.x_orig + ') target(' + l.target.fixed_x + ',' + l.target.x_orig + ')');
    });
    debugLines.push('-->');
    var debugComment = document.createComment(debugLines.join('\n'));
    c.appendChild(debugComment);

    g.selectAll('path.cladogram-link')
      .data(root.links())
      .enter().append('path')
        .attr('class','cladogram-link')
        .attr('d', function(d){ return diagonal(d.source, d.target); })
        .attr('fill','none')
        .style('stroke', function(d){
          var k = kingdomOf(d.target);
          return KINGDOM_COLORS[k] || '#888';
        })
        .style('stroke-opacity', '0.85')
        .style('stroke-width', '3px');

    // Nodes
    var node = g.selectAll('g.cladogram-node')
      .data(root.descendants())
      .enter().append('g')
        .attr('class','cladogram-node')
        .attr('transform', function(d){ return 'translate(' + d.fixed_x + ',' + d.x_orig + ')'; });

    // Circle at each node
    node.append('circle')
      .attr('r', function(d){ return d.depth === 0 ? 0 : (d.children ? 5 : 6); })
      .attr('fill', function(d){
        if (d.depth === 0) return 'transparent';
        var k = kingdomOf(d);
        return KINGDOM_COLORS[k] || '#888';
      })
      .attr('stroke','white')
      .attr('stroke-width', 1.5);

    // Labels: internal nodes get label above the link to parent, leaves get label to the right
    // Label backgrounds: semi-transparent white rectangles behind each label
    // so connector lines and adjacent labels remain readable.
    var labelSel = node.filter(function(d){return d.depth > 0;});
    // First, create the text to measure, then prepend a rect behind each.
    labelSel.each(function(d){
      var grp = d3.select(this);
      var rawSize = Math.max(9.5, 13 - d.depth * 0.5);
      // Compound names (depth 7) do not scale with fontMul
      var size = (d.depth === 7) ? rawSize : rawSize * fontMul;
      var anchor = d.children ? 'end' : 'start';
      var dx = d.children ? -5 : 8;
      var dy = d.children ? -6 : 4;
      var t = grp.append('text')
        .attr('x', dx).attr('y', dy)
        .attr('text-anchor', anchor)
        .attr('font-size', size + 'px')
        .attr('fill','#2c3e50')
        .text(d.data.name);
      // Compute bbox for the background rect
      try {
        var bb = t.node().getBBox();
        grp.insert('rect', 'text')
          .attr('x', bb.x - 2).attr('y', bb.y - 1)
          .attr('width', bb.width + 4).attr('height', bb.height + 2)
          .attr('fill', 'white').attr('fill-opacity', 0.5).attr('rx', 1);
      } catch(e){ /* getBBox may fail on hidden elements */ }
    });

    // Leaf count badge (next to family-rank leaves)
    node.filter(function(d){ return !d.children && d.depth >= 4; })
      .append('text')
        .attr('x', function(d){
          var text = d.data.name || '';
          return 8 + text.length * 6 + 6;
        })
        .attr('y', 4)
        .attr('font-size','10px')
        .attr('fill','var(--text-muted)')
        .attr('font-variant-numeric','tabular-nums')
        .text(function(d){ return d.data.value ? d.data.value.toLocaleString() : ''; });

    // Click handler: every clade node (depth 1..6) redirects to /search at the
    // corresponding rank. Preserves all existing URL params (chem properties,
    // region/license filters, etc.) so the filter context propagates.
    var DEPTH_TO_TYPE = {1: 'kingdom', 2: 'phylum', 3: 'tax_class', 4: 'order', 5: 'family', 6: 'genus', 7: 'name'};
    node.filter(function(d){ return d.depth >= 1 && d.depth <= 7; })
      .style('cursor','pointer')
      .on('click', function(event, d){
        event.stopPropagation();
        event.preventDefault();
        var nm = d.data.name;
        if (!nm || nm === '(unresolved)') return;
        var rank = DEPTH_TO_TYPE[d.depth];
        if (!rank) return;
        var params = new URLSearchParams(window.location.search);
        // Replace any current primary type/q (it was the previous search context)
        // with the clicked-clade as a new primary filter. Existing extras carry over.
        params.set('type', rank);
        params.set('q', nm);
        params.delete('page');
        window.location.href = '/search?' + params.toString();
      });

    // Hover tooltip
    var tip = document.getElementById('cladogram-tip');
    node.on('mouseenter', function(event, d){
      if (d.depth === 0) return;
      var rankName = RANK_DEPTH[d.depth] || ('depth ' + d.depth);
      tip.style.display = '';
      tip.innerHTML = '<strong>' + d.data.name + '</strong> (' + rankName + ', ' +
                      (d.data.value ? d.data.value.toLocaleString() : 0) + ' compounds)';
    }).on('mousemove', function(event){
      tip.style.left = (event.clientX + 12) + 'px';
      tip.style.top  = (event.clientY + 12) + 'px';
    }).on('mouseleave', function(){
      tip.style.display = 'none';
    });

    // Expand-more / Show-all controls beneath the SVG
    var nLeaves = root.leaves().length;
    function _capLabel(c){ return (c >= 999) ? 'unlimited' : c; }
    var capRanks = [
      ['kingdom', 1], ['phylum', 2], ['class', 3],
      ['order', 4], ['family', 5], ['genus', 6]
    ];
    var capsParts = capRanks
      .filter(function(p){ return CAPS_SEQUENCE[currentCapsIdx][p[1]] < 999; })
      .map(function(p){ return p[0] + '=' + CAPS_SEQUENCE[currentCapsIdx][p[1]]; });
    // Only show ranks where this caps tuple actually constrained anything.
    // If every rank is unlimited, drop the caps prefix entirely.
    var hasAnyCap = CAPS_SEQUENCE[currentCapsIdx].slice(1).some(function(c){ return c < 999; });
    var capsStr = hasAnyCap ? ('caps: ' + capsParts.join(', ')) : 'showing entire tree';
    // Compound cycle button label = the next mode's label
    var compoundBtnLabel = COMPOUND_MODES[compoundMode].label_next;
    var btnStyle = 'padding:0.25rem 0.7rem;font-size:0.78rem;border:1px solid var(--border);background:white;cursor:pointer;border-radius:3px;';
    var compoundBtn = '<button id="cladogram-toggle-compounds" type="button" style="' + btnStyle + '">' + compoundBtnLabel + '</button>';
    var fontDec = '<button id="cladogram-font-dec" type="button" style="padding:0.1rem 0.5rem;font-size:0.8rem;border:1px solid var(--border);background:white;cursor:pointer;border-radius:3px;">&minus;</button>';
    var fontInc = '<button id="cladogram-font-inc" type="button" style="padding:0.1rem 0.5rem;font-size:0.8rem;border:1px solid var(--border);background:white;cursor:pointer;border-radius:3px;">+</button>';
    var fontLabel = '<span style="color:var(--text-muted);margin:0 0.25rem;">Font</span>';
    var exportSvg = '<button id="cladogram-export-svg" type="button" style="' + btnStyle + '">SVG</button>';
    var exportPng = '<button id="cladogram-export-png" type="button" style="' + btnStyle + '">PNG</button>';
    var exportLabel = '<span style="color:var(--text-muted);margin:0 0.25rem 0 0.6rem;">Export</span>';

    var controls = document.createElement('div');
    controls.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-top:0.8rem;padding:0.4rem 0.6rem;border-top:1px solid var(--border);font-size:0.78rem;color:var(--text-muted);flex-wrap:wrap;gap:0.4rem;';
    controls.innerHTML =
      '<div>Showing ' + nLeaves + ' terminal nodes. ' + capsStr + '</div>' +
      '<div style="display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap;">' +
        compoundBtn +
        (currentCapsIdx < CAPS_SEQUENCE.length - 1 ?
          '<button id="cladogram-expand-more" type="button" style="' + btnStyle + '">Expand more</button>' : '') +
        (currentCapsIdx < CAPS_SEQUENCE.length - 1 ?
          '<button id="cladogram-show-all" type="button" style="' + btnStyle + '">Show all</button>' : '') +
        fontLabel + fontDec + fontInc +
        exportLabel + exportSvg + exportPng +
      '</div>';
    c.appendChild(controls);
    var compBtn = document.getElementById('cladogram-toggle-compounds');
    if (compBtn) compBtn.addEventListener('click', function(){
      compoundMode = (compoundMode + 1) % COMPOUND_MODES.length;
      applyCapsAndRerender();
    });
    var fontDecBtn = document.getElementById('cladogram-font-dec');
    if (fontDecBtn) fontDecBtn.addEventListener('click', function(){
      fontMul = Math.max(0.6, fontMul - 0.1);
      applyCapsAndRerender();
    });
    var fontIncBtn = document.getElementById('cladogram-font-inc');
    if (fontIncBtn) fontIncBtn.addEventListener('click', function(){
      fontMul = Math.min(1.6, fontMul + 0.1);
      applyCapsAndRerender();
    });
    var svgBtn = document.getElementById('cladogram-export-svg');
    if (svgBtn) svgBtn.addEventListener('click', function(){
      exportSvgFile();
    });
    var pngBtn = document.getElementById('cladogram-export-png');
    if (pngBtn) pngBtn.addEventListener('click', function(){
      exportPngFile();
    });
    var moreBtn = document.getElementById('cladogram-expand-more');
    if (moreBtn) moreBtn.addEventListener('click', function(){
      currentCapsIdx = Math.min(currentCapsIdx + 1, CAPS_SEQUENCE.length - 1);
      applyCapsAndRerender();
    });
    var allBtn = document.getElementById('cladogram-show-all');
    if (allBtn) allBtn.addEventListener('click', function(){
      currentCapsIdx = CAPS_SEQUENCE.length - 1;
      applyCapsAndRerender();
    });
  }

  function exportSvgFile(){
    var svgEl = document.querySelector('#cladogram-container svg');
    if (!svgEl) return;
    var clone = svgEl.cloneNode(true);
    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    var src = '<?xml version="1.0" encoding="UTF-8"?>\n' + new XMLSerializer().serializeToString(clone);
    var blob = new Blob([src], {type: 'image/svg+xml;charset=utf-8'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = 'theobroma_cladogram.svg';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function exportPngFile(){
    var svgEl = document.querySelector('#cladogram-container svg');
    if (!svgEl) return;
    var clone = svgEl.cloneNode(true);
    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    var src = new XMLSerializer().serializeToString(clone);
    var img = new Image();
    var blob = new Blob([src], {type: 'image/svg+xml;charset=utf-8'});
    var url = URL.createObjectURL(blob);
    img.onload = function(){
      var w = parseInt(svgEl.getAttribute('width')) || svgEl.clientWidth || 1200;
      var h = parseInt(svgEl.getAttribute('height')) || svgEl.clientHeight || 800;
      // Render at 2x for sharper PNG
      var scale = 2;
      var canvas = document.createElement('canvas');
      canvas.width = w * scale; canvas.height = h * scale;
      var ctx = canvas.getContext('2d');
      ctx.fillStyle = 'white'; ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      ctx.drawImage(img, 0, 0, w, h);
      URL.revokeObjectURL(url);
      canvas.toBlob(function(pngBlob){
        var pngUrl = URL.createObjectURL(pngBlob);
        var a = document.createElement('a');
        a.href = pngUrl; a.download = 'theobroma_cladogram.png';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        URL.revokeObjectURL(pngUrl);
      }, 'image/png');
    };
    img.onerror = function(){ URL.revokeObjectURL(url); alert('PNG export failed'); };
    img.src = url;
  }
})();
</script>
