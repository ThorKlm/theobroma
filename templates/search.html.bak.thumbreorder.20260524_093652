<script>
// Dropdown-trigger arrow click and visibility logic
document.addEventListener('click', function(e) {
    if (e.target.classList && e.target.classList.contains('dropdown-trigger')) {
        e.preventDefault();
        e.stopPropagation();
        var row = e.target.closest('.search-row');
        if (!row) return;
        var sel = row.querySelector('select[name="type"], select[name^="extra_type_"]');
        if (!sel) return;
        // Trigger the appropriate handler manually
        var event = new Event('change', { bubbles: true });
        sel.dispatchEvent(event);
    }
});

// Show/hide arrow based on current type
function updateDropdownArrows() {
    document.querySelectorAll('.search-row').forEach(function(row) {
        var trigger = row.querySelector('.dropdown-trigger');
        if (!trigger) return;
        var sel = row.querySelector('select[name="type"], select[name^="extra_type_"]');
        if (!sel) return;
        var t = sel.value;
        var hasDropdown = ['kingdom','region','source','class','genus','family','order','tax_class','phylum','npclassifier_class','classyfire_class'].indexOf(t) >= 0;
        trigger.style.display = hasDropdown ? '' : 'none';
    });
}

// Run on load and after any type change
document.addEventListener('DOMContentLoaded', function() {
    updateDropdownArrows();
    document.querySelectorAll('select[name="type"], select[name^="extra_type_"]').forEach(function(s) {
        s.addEventListener('change', updateDropdownArrows);
    });
});
// Also re-run after addFilter (which creates new rows dynamically)
var _origAddFilter = window.addFilter;
if (_origAddFilter) {
    window.addFilter = function() {
        _origAddFilter.apply(this, arguments);
        setTimeout(updateDropdownArrows, 0);
    };
}
</script>
