{% extends "base.html" %}
{% from "_sort_header.html" import sort_header %}
{% block title %}Search &mdash; THEOBROMA{% endblock %}
{% block content %}
<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem;flex-wrap:wrap;" class="hero-row">
    <h1 class="section-title" style="margin:0;">Search</h1>
    {% include "_linear_tree_thumb.html" %}
    {% if region_counts_filtered %}
    <div id="region-map" style="width:280px;height:140px;flex-shrink:1;overflow:hidden;">
      {% include "_world_map_body.svg" %}
      <style>{{ region_css|safe }}</style>
      <script>
      (function(){
        var titles = {{ region_titles|tojson }};
        var div = document.getElementById('region-map');
        if (!div) return;
        Object.keys(titles).forEach(function(iso2){
          var a = div.querySelector('#a_' + iso2);
          if (!a) return;
          var t = a.querySelector('title');
          if (!t) {
            t = document.createElementNS('http://www.w3.org/2000/svg', 'title');
            a.insertBefore(t, a.firstChild);
          }
          t.textContent = titles[iso2];
        });
      })();
      </script>
    </div>
    {% endif %}
    {% if thumb and thumb.svg %}
    <a href="#" class="kingdom-thumb-wrap" style="display:flex;align-items:center;gap:0.75rem;font-size:0.78rem;line-height:1.3;text-decoration:none;color:inherit;">
      {{ thumb.svg|safe }}
      <div class="kingdom-legend" style="display:grid;grid-template-columns:auto auto auto;gap:0.15rem 0.4rem;text-align:left;width:max-content;">
        {% for kingdom, count, pct in thumb.legend %}
        <span style="display:inline-block;width:0.7rem;height:0.7rem;border-radius:2px;background:var(--kingdom-{{ kingdom }});border:1px solid rgba(0,0,0,0.1);"></span>
        <span>{{ kingdom }}</span>
        <span style="text-align:right;color:var(--text-muted);white-space:nowrap;">{{ "{:,}".format(count) }}&nbsp;({{ "%.1f"|format(pct) }}%)</span>
        {% endfor %}
        <span></span>
        <span style="grid-column:2 / 4;font-style:italic;color:var(--accent);margin-top:0.2rem;">(click to expand tree)</span>
      </div>
    </a>
    {% endif %}
</div>
