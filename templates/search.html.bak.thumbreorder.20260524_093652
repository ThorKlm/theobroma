function loadOptions() {
    if (optionsCache) return Promise.resolve(optionsCache);
    return fetch('/api/filter_options').then(function(r){return r.json()}).then(function(d){
        optionsCache = d; return d;
    });
}

function onTypeChange(sel, idx) {
    var t = sel.value;
    var row = sel.closest('.search-row');
    var textWrap = row.querySelector('.search-input-wrap') || document.getElementById('text-input-' + idx);
    var rangeWrap = row.querySelector('.range-input') || document.getElementById('range-input-' + idx);
    var propSel = row.querySelector('.prop-subselect') || document.getElementById('prop-type-' + idx);
    var old = row.querySelector('.search-submenu');
    if (old) old.remove();

    if (t === 'property') {
        if (propSel) propSel.style.display = '';
        onPropChange(propSel, idx);
        return;
    }

    if (propSel) propSel.style.display = 'none';
    if (textWrap) textWrap.style.display = '';
    if (rangeWrap) rangeWrap.style.display = 'none';

    var input = textWrap ? textWrap.querySelector('input[type="text"]') : null;
    if (!input) return;

    if (['kingdom','region','source','class','genus','family'].indexOf(t) >= 0 && !restoring) {
        loadOptions().then(function(opts) {
            var items = opts[t];
            if (!items || items.length === 0) return;
            var sub = document.createElement('div');
            sub.className = 'search-submenu';
            items.forEach(function(item) {
                var div = document.createElement('div');
                div.className = 'submenu-item';
                div.textContent = item;
                div.addEventListener('click', function() {
                    input.value = item;
                    sub.style.display = 'none';
                });
                sub.appendChild(div);
            });
            row.style.position = 'relative';
            row.appendChild(sub);
        });
        input.placeholder = 'Select or type...';
    } else {
        input.placeholder = 'Search compounds...';
    }
}

function onPropChange(sel, idx) {
    var pt = sel.value;
    var row = sel.closest('.search-row');
    var textWrap = row.querySelector('.search-input-wrap') || document.getElementById('text-input-' + idx);
    var rangeWrap = row.querySelector('.range-input') || document.getElementById('range-input-' + idx);
    var old = row.querySelector('.search-submenu');
    if (old) old.remove();

    // Class-like prop types (npclassifier_class, classyfire_class, and the
    // legacy 'class' alias) all show a text input with a typed submenu drawn
    // from the matching filter_options key.
    var classProps = {
        "npclassifier_class": "npclassifier_class",
        "classyfire_class":   "classyfire_class",
        "class":              "class"
    };
    if (pt in classProps) {
        if (textWrap) textWrap.style.display = '';
        if (rangeWrap) rangeWrap.style.display = 'none';
        var input = textWrap ? textWrap.querySelector('input[type="text"]') : null;
        var typesel = row.querySelector('select[name^="type"], select[name^="extra_type"]');
        if (typesel) typesel.value = 'property';
        if (input) {
            input.name = input.name || 'q';
            input.placeholder = (pt === 'classyfire_class' ? 'Select or type ClassyFire superclass...'
                                                           : 'Select or type NPClassifier class...');
        }
        if (!restoring) loadOptions().then(function(opts) {
            var items = opts[classProps[pt]];
            if (!items || items.length === 0) return;
            var sub = document.createElement('div');
            sub.className = 'search-submenu';
            items.forEach(function(item) {
                var div = document.createElement('div');
                div.className = 'submenu-item';
                div.textContent = item;
                div.addEventListener('click', function() {
                    if (input) input.value = item;
                    sub.style.display = 'none';
                });
                sub.appendChild(div);
            });
            row.style.position = 'relative';
            row.appendChild(sub);
        });
    } else {
        if (textWrap) textWrap.style.display = 'none';
        if (!rangeWrap) {
            rangeWrap = document.createElement('div');
            rangeWrap.className = 'range-input';
            rangeWrap.id = 'range-input-' + idx;
            row.appendChild(rangeWrap);
        }
        rangeWrap.style.display = 'flex';
        var r = propRanges[pt] || {min:0, max:100, mean:50};
        rangeWrap.innerHTML =
            '<input type="number" name="' + pt + '_min" placeholder="' + r.min + '" step="any" value="">' +
            '<span style="font-size:0.8rem;color:var(--text-muted);margin:0 0.3rem;">to</span>' +
            '<input type="number" name="' + pt + '_max" placeholder="' + r.max + '" step="any" value="">' +
            '<span style="font-size:0.72rem;color:var(--text-muted);margin-left:0.5rem;">(mean: ' + r.mean + ')</span>';
    }
}

