(function(){
    var input = document.getElementById('search-q');
    var list = document.getElementById('autocomplete-list');
    var typesel = document.getElementById('search-type');
    var timer;
    if (!input) return;
    input.addEventListener('input', function(){
        clearTimeout(timer);
        var q = this.value.trim(), t = typesel.value;
        if (q.length < 2 || (t !== 'name' && t !== 'organism')) { list.innerHTML=''; return; }
        timer = setTimeout(function(){
            fetch((t==='organism'?'/api/organisms':'/api/autocomplete')+'?q='+encodeURIComponent(q))
            .then(function(r){return r.json()}).then(function(data){
                list.innerHTML='';
                data.forEach(function(name){
                    var div=document.createElement('div'); div.className='ac-item'; div.textContent=name;
                    div.addEventListener('click',function(){input.value=name;list.innerHTML='';});
                    list.appendChild(div);
                });
            });
        }, 200);
    });
})();

(function(){
    var sel = document.getElementById('search-type');
    if (sel && sel.value === 'property') {
        onTypeChange(sel, 0);
    }
})();

document.addEventListener('click', function(e) {
    if (!e.target.closest('.search-row') && !e.target.closest('.search-input-wrap')) {
        document.querySelectorAll('.search-submenu').forEach(function(m){m.style.display='none';});
        document.querySelectorAll('.autocomplete-list').forEach(function(m){m.innerHTML='';});
    }
});

(function(){
    restoring = true;
    var params = new URLSearchParams(window.location.search);
    var typesel = document.getElementById('search-type');
    var mainType = params.get('type') || 'name';
    if (typesel) {
        for (var i = 0; i < typesel.options.length; i++) {
            if (typesel.options[i].value === mainType) {
                typesel.selectedIndex = i;
                break;
            }
        }
        if (mainType === 'property') {
            onTypeChange(typesel, 0);
            var propSel = document.getElementById('prop-type-0');
            var propType = params.get('prop_type') || 'npclassifier_class';
            if (propSel) {
                for (var i = 0; i < propSel.options.length; i++) {
                    if (propSel.options[i].value === propType) {
                        propSel.selectedIndex = i;
                        break;
                    }
                }
                onPropChange(propSel, 0);
            }
            var props = Object.keys(propRanges);
            props.forEach(function(p) {
                var mn = params.get(p + '_min');
                var mx = params.get(p + '_max');
                var rangeDiv = document.getElementById('range-input-0');
                if (rangeDiv) {
                    var inputs = rangeDiv.querySelectorAll('input[type="number"]');
                    inputs.forEach(function(inp) {
                        if (inp.name === p + '_min' && mn) inp.value = mn;
                        if (inp.name === p + '_max' && mx) inp.value = mx;
                    });
                }
            });
        }
    }

    for (var i = 1; i <= 5; i++) {
        var et = params.get('extra_type_' + i);
        var eq = params.get('extra_q_' + i);
        var ep = params.get('extra_prop_' + i);
        if (!et) continue;
        if (et || eq) {
            addFilter();
            var row = document.getElementById('search-row-' + filterCount);
            if (!row) continue;
            var sel = row.querySelector('select[name^="extra_type"]');
            if (sel) {
                for (var j = 0; j < sel.options.length; j++) {
                    if (sel.options[j].value === et) {
                        sel.selectedIndex = j;
                        break;
                    }
                }
                onTypeChange(sel, filterCount);
                if (et === 'property' && ep) {
                    var propSel = row.querySelector('.prop-subselect');
                    if (propSel) {
                        for (var j = 0; j < propSel.options.length; j++) {
                            if (propSel.options[j].value === ep) {
                                propSel.selectedIndex = j;
                                break;
                            }
                        }
                        onPropChange(propSel, filterCount);
                    }
                }
            }
            var input = row.querySelector('input[type="text"]');
            if (input && eq) input.value = eq;
        }
    }

    restoring = false;
    var props = Object.keys(propRanges);
    props.forEach(function(p) {
        var mn = params.get(p + '_min');
        var mx = params.get(p + '_max');
        if (mn || mx) {
            document.querySelectorAll('input[name="' + p + '_min"]').forEach(function(inp) {
                if (mn) inp.value = mn;
            });
            document.querySelectorAll('input[name="' + p + '_max"]').forEach(function(inp) {
                if (mx) inp.value = mx;
            });
        }
    });
})();
</script>
