{% extends "base.html" %}
{% block title %}THEOBROMA &mdash; Natural Products Database
{% endblock %}
{% block content %}
<div class="hero" style="position:relative;">
    <div class="hero-glow"></div>
    <h1>THEOBROMA</h1>
    <p class="subtitle">An open multi-kingdom natural products database aggregating 29 source databases across four biological kingdoms (plant, fungi, bacteria, animal), 14 resolved geographic regions, and a residual unresolved category, with per-compound license tiers for legally-aware drug discovery. Cross-kingdom attributions are preserved via a secondary-kingdoms layer so a single compound can appear under every kingdom in which it has been reported.</p>
    <div class="stat-row">
        <a href="/browse" class="stat-item"><div class="stat-num">{{ "{:,}".format(total) }}</div><div class="stat-label">Compounds</div></a>
        <a href="/sources" class="stat-item"><div class="stat-num">{{ n_sources }}</div><div class="stat-label">Source databases</div></a>
        <a href="/statistics" class="stat-item"><div class="stat-num">{{ kingdoms|length }}</div><div class="stat-label">Kingdoms</div></a>
        <a href="/statistics" class="stat-item"><div class="stat-num">{{ n_regions }}</div><div class="stat-label">Regions</div></a>
    </div>
    <div class="kingdoms-row">
        {% for k in kingdoms %}
        <a href="/browse?kingdom={{ k.kingdom }}" class="kingdom-chip">
            <span class="kingdom-dot" style="background:var(--kingdom-{{ k.kingdom|lower|default('unknown') }})"></span>
            {{ k.kingdom }} <strong>{{ "{:,}".format(k.cnt) }}</strong>
        </a>
        {% endfor %}
    </div>
    {% if regions %}
    <div class="kingdoms-row" style="margin-top:0.5rem;">
        {% for r in regions if r.reg != 'unresolved' and r.cnt >= 100 %}
        <a href="/browse?region={{ r.reg }}" class="kingdom-chip">
            <span class="kingdom-dot" style="background:var(--accent)"></span>
            {{ r.reg }} <strong>{{ "{:,}".format(r.cnt) }}</strong>
        </a>
        {% endfor %}
    </div>
    {% endif %}
</div>
<div class="search-box">
    <form action="/search" method="get" class="search-form" id="main-search">
        <select name="type" id="search-type">
            <option value="name">Compound name</option>
            <option value="smiles">SMILES</option>
            <option value="inchikey">InChIKey</option>
            <option value="organism">Source organism</option>
            <option value="source">Source database</option>
            <option value="region">Geographic region</option>
            <option value="kingdom">Kingdom</option>
            <option value="genus">Genus</option>
            <option value="family">Family</option>
            <option value="order">Order</option>
            <option value="tax_class">Class (taxonomic)</option>
            <option value="phylum">Phylum</option>
            <option value="class">Chemical class</option>
        </select>
        <div class="search-input-wrap">
            <input type="text" name="q" id="search-q" placeholder="Search compounds..." autocomplete="off">
            <div id="autocomplete-list" class="autocomplete-list"></div>
        </div>
        <button type="submit">Search</button>
    </form>
    <div id="extra-filters-home" style="margin-top:0.5rem;"></div>
    <div style="margin-top:0.5rem;">
        <a href="#" id="add-filter-btn-home" onclick="addFilterHome();return false;" class="add-filter-link" style="font-size:0.85rem;color:var(--accent);text-decoration:none;border:1px dashed var(--border);padding:0.3rem 0.6rem;border-radius:var(--radius);background:rgba(0,0,0,0.02);">+ Add filter</a>
    </div>
    <p class="search-hint">Try: <a href="/search?q=curcumin&type=name">curcumin</a> &middot; <a href="/search?q=quercetin&type=name">quercetin</a> &middot; <a href="/search?q=Streptomyces&type=organism">Streptomyces</a> &middot; <a href="/search?q=Triterpenoids&type=class">Triterpenoids</a> &middot; <a href="/search?q=fungi&type=kingdom">fungi</a> &middot; <span class="hint-key">/</span> to focus</p>
</div>
<div class="hero-row" style="display:flex;align-items:center;justify-content:center;gap:2rem;margin:1.5rem 0;flex-wrap:wrap;">
    {% include "_linear_tree_thumb.html" %}
{% if home_thumb and home_thumb.svg %}
      <a href="/taxonomy" class="kingdom-thumb-wrap" style="display:flex;align-items:center;gap:0.75rem;text-decoration:none;color:inherit;font-size:0.78rem;line-height:1.3;">
        {{ home_thumb.svg|safe }}
        <div style="display:grid;grid-template-columns:auto auto auto;gap:0.15rem 0.4rem;text-align:left;width:max-content;">
          {% for kingdom, count, pct in home_thumb.legend %}
          <span style="display:inline-block;width:0.7rem;height:0.7rem;border-radius:2px;background:var(--kingdom-{{ kingdom }});border:1px solid rgba(0,0,0,0.1);"></span>
          <span>{{ kingdom }}</span>
          <span style="text-align:right;color:var(--text-muted);white-space:nowrap;">{{ "{:,}".format(count) }}&nbsp;({{ "%.1f"|format(pct) }}%)</span>
          {% endfor %}
          <span></span>
          <span style="grid-column:2 / 4;font-style:italic;color:var(--accent);margin-top:0.2rem;">(click to expand tree)</span>
        </div>
      </a>
      {% endif %}
    {% if home_region_counts %}
      <div id="region-map" style="width:280px;height:140px;flex-shrink:0;overflow:hidden;">
        {% include "_world_map_body.svg" %}
        <style>{{ home_region_css|safe }}</style>
        <script>
        (function(){
          var titles = {{ home_region_titles|tojson }};
          var div = document.getElementById('region-map');
          if (!div) return;
          Object.keys(titles).forEach(function(iso2){
            var a = div.querySelector('#a_' + iso2);
            if (!a) return;
            var ti = a.querySelector('title');
            if (!ti) {
              ti = document.createElementNS('http://www.w3.org/2000/svg', 'title');
              a.insertBefore(ti, a.firstChild);
            }
            ti.textContent = titles[iso2];
          });
        })();
        </script>
      </div>

    {% endif %}
</div>
<script>
var filterCountHome = 0;
function addFilterHome() {
    filterCountHome++;
    var container = document.getElementById('extra-filters-home');
    var row = document.createElement('div');
    row.className = 'search-row extra-filter';
    row.style.cssText = 'display:flex;gap:0.5rem;margin-top:0.5rem;align-items:center;';
    var idx = filterCountHome;
    row.innerHTML = '<span class="and-label" style="font-size:0.8rem;color:var(--text-muted);">AND</span>' +
        '<select name="extra_type_' + idx + '" style="font-size:0.85rem;padding:0.4rem;">' +
        '<option value="">-- select type --</option>' +
        '<option value="name">Compound name</option>' +
        '<option value="organism">Source organism</option>' +
        '<option value="source">Source database</option>' +
        '<option value="region">Geographic region</option>' +
        '<option value="kingdom">Kingdom</option>' +
        '<option value="genus">Genus</option>' +
        '<option value="family">Family</option>' +
        '<option value="order">Order</option>' +
        '<option value="tax_class">Class (taxonomic)</option>' +
        '<option value="phylum">Phylum</option>' +
        '<option value="class">Chemical class</option>' +
        '</select>' +
        '<input type="text" name="extra_q_' + idx + '" placeholder="filter value..." style="flex:1;padding:0.4rem;">' +
        '<a href="#" onclick="this.parentNode.remove();return false;" style="font-size:0.8rem;color:#c0392b;">x</a>';
    container.appendChild(row);
    // The form needs to know to include extra params; since they're inside the form-following div,
    // we need to move them inside the form, or change the form to wrap everything
}

// Ensure the form sweeps up all filter values on submit by appending hidden inputs from extra rows
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('main-search');
    if (form) {
        form.addEventListener('submit', function(e) {
            var extras = document.querySelectorAll('#extra-filters-home select, #extra-filters-home input');
            extras.forEach(function(el) {
                if (el.name && el.value) {
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = el.name;
                    hidden.value = el.value;
                    form.appendChild(hidden);
                }
            });
        });
    }
});
</script>
<script>
(function(){
    var typesel = document.getElementById('search-type');
    var input = document.getElementById('search-q');
    var optionsCache = null;
    var submenu = document.createElement('div');
    submenu.className = 'search-submenu';
    submenu.style.display = 'none';
    typesel.parentNode.style.position = 'relative';
    typesel.parentNode.appendChild(submenu);

    function loadOptions() {
        if (optionsCache) return Promise.resolve(optionsCache);
        return fetch('/api/filter_options').then(function(r){return r.json()}).then(function(d){
            optionsCache = d;
            return d;
        });
    }

    function showSubmenu(type) {
        loadOptions().then(function(opts) {
            var items = opts[type];
            if (!items || items.length === 0) { submenu.style.display = 'none'; return; }
            submenu.innerHTML = '';
            items.forEach(function(item) {
                var div = document.createElement('div');
                div.className = 'submenu-item';
                div.textContent = item;
                div.addEventListener('click', function() {
                    input.value = item;
                    submenu.style.display = 'none';
                });
                submenu.appendChild(div);
            });
            submenu.style.display = 'block';
        });
    }

    typesel.addEventListener('change', function() {
        var t = this.value;
        if (['kingdom','region','source','class','genus','family'].indexOf(t) >= 0) {
            showSubmenu(t);
            input.placeholder = 'Select or type ' + t + '...';
        } else {
            submenu.style.display = 'none';
            input.placeholder = 'Search compounds...';
        }
    });

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.search-form')) submenu.style.display = 'none';
    });
})();
</script>
<script>
(function(){
    var input = document.getElementById('search-q');
    var list = document.getElementById('autocomplete-list');
    var typesel = document.getElementById('search-type');
    var timer;
    input.addEventListener('input', function(){
        clearTimeout(timer);
        var q = this.value.trim();
        var t = typesel.value;
        if (q.length < 2 || (t !== 'name' && t !== 'organism')) { list.innerHTML=''; return; }
        timer = setTimeout(function(){
            var endpoint = t === 'organism' ? '/api/organisms' : '/api/autocomplete';
            fetch(endpoint+'?q='+encodeURIComponent(q))
            .then(function(r){return r.json()})
            .then(function(data){
                list.innerHTML = '';
                data.forEach(function(name){
                    var div = document.createElement('div');
                    div.className = 'ac-item';
                    div.textContent = name;
                    div.addEventListener('click', function(){ input.value=name; list.innerHTML=''; });
                    list.appendChild(div);
                });
            });
        }, 200);
    });
    document.addEventListener('click', function(e){ if(!e.target.closest('.search-input-wrap')) list.innerHTML=''; });
})();
</script>
