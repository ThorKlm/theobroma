<div id="cladogram-panel" style="display:none;margin:1rem 0 1.5rem 0;">
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.4rem;">
      <div>
        <div style="font-size:0.85rem;color:var(--text-muted);">Linear cladogram</div>
        <div style="font-size:1.1rem;font-weight:600;color:var(--text-strong);margin-top:0.1rem;">Compounds by taxonomic order</div>
      </div>
      <div style="text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:0.25rem;">
        <a href="#" id="cladogram-close" style="font-size:0.8rem;color:var(--accent);text-decoration:none;">[ close ]</a>
        <div id="cladogram-query-list" style="font-size:0.78rem;color:var(--text-muted);font-family:monospace;line-height:1.35;text-align:right;"></div>
      </div>
    </div>
    <div id="cladogram-container" style="width:100%;font-size:0.85rem;"></div>
    <div id="cladogram-loading" style="text-align:center;padding:2rem;color:var(--text-muted);display:none;">Loading cladogram...</div>
    <div style="display:flex;justify-content:flex-end;font-size:0.72rem;color:var(--text-muted);margin-top:0.3rem;">THEOBROMA {{ theobroma_version }}</div>
  </div>
</div>
<script>
(function(){
  var loaded = false, data = null, expanded = false;
  var wrap = document.querySelector('.linear-tree-thumb-wrap');
  var panel = document.getElementById('cladogram-panel');
  var closeBtn = document.getElementById('cladogram-close');
  if (!wrap || !panel) return;

  function toggle(e){
    if (e) e.preventDefault();
    expanded = !expanded;
    panel.style.display = expanded ? '' : 'none';
    if (expanded && !loaded) loadAndRender();
  }
  wrap.addEventListener('click', toggle);
  closeBtn.addEventListener('click', toggle);

  // Populate query-list (mirrors taxonomy_expand pattern)
  var qs = window.location.search.replace(/^\?/, '');
  var ql = document.getElementById('cladogram-query-list');
  if (qs && ql) {
    var parts = qs.split('&').filter(function(p){
      var k = p.split('=')[0];
      return p && k !== 'page' && k !== 'sort' && k !== 'order' && k !== 'per_page';
    });
    if (parts.length > 0) {
      ql.innerHTML = parts.map(function(p){
        var kv = p.split('=');
        return kv[0] + ': ' + decodeURIComponent((kv[1] || '').replace(/\+/g, ' '));
      }).join('<br>');
    }
  }

  function loadAndRender(){
    document.getElementById('cladogram-loading').style.display = '';
    var url = '/api/cladogram' + window.location.search;
    fetch(url).then(function(r){return r.json();}).then(function(d){
      data = d;
      loaded = true;
      document.getElementById('cladogram-loading').style.display = 'none';
      render();
    }).catch(function(err){
      document.getElementById('cladogram-loading').textContent = 'Failed: ' + err;
    });
  }

  function render(){
    var c = document.getElementById('cladogram-container');
    c.innerHTML = '';
    if (!data || !data.orders || !data.orders.length){
      c.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);">No taxonomic orders to display for this filter.</div>';
      return;
    }
    var maxN = Math.max.apply(null, data.orders.map(function(o){return o.count;}));
    var orderRows = data.orders.map(function(o, idx){
      var pct = (o.count / maxN * 100).toFixed(1);
      var kingdomColor = 'var(--kingdom-' + (o.kingdom || 'plant') + ')';
      var hasFams = o.has_families && o.families.length > 0;
      var caret = hasFams ? '<span class="caret" style="display:inline-block;width:0.8rem;color:var(--text-muted);transition:transform 0.15s;">&#9656;</span>' : '<span style="display:inline-block;width:0.8rem;"></span>';
      return (
        '<div class="cladogram-order" data-idx="'+idx+'" style="margin-bottom:0.2rem;' + (hasFams ? 'cursor:pointer;' : '') + '">' +
          '<div style="display:grid;grid-template-columns:1.2rem 200px 1fr 60px;align-items:center;gap:0.4rem;height:18px;">' +
            caret +
            '<span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="'+o.name+'">'+o.name+'</span>' +
            '<span style="display:inline-block;height:10px;background:'+kingdomColor+';width:'+pct+'%;border-radius:1px;"></span>' +
            '<span style="text-align:right;color:var(--text-muted);font-variant-numeric:tabular-nums;">'+o.count.toLocaleString()+'</span>' +
          '</div>' +
          '<div class="cladogram-families" style="display:none;margin-left:1.7rem;padding-left:0.4rem;border-left:1px solid var(--border);margin-top:0.15rem;margin-bottom:0.3rem;"></div>' +
        '</div>'
      );
    }).join('');
    c.innerHTML = (
      '<div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:0.5rem;">' +
        data.orders.length + ' orders, ' + data.total.toLocaleString() + ' compound-attestations. Click an order to expand families.' +
      '</div>' + orderRows
    );

    Array.prototype.forEach.call(c.querySelectorAll('.cladogram-order'), function(el){
      el.addEventListener('click', function(){
        var idx = +el.getAttribute('data-idx');
        var order = data.orders[idx];
        if (!order.has_families) return;
        var famsDiv = el.querySelector('.cladogram-families');
        var caret = el.querySelector('.caret');
        if (famsDiv.style.display === 'none'){
          if (!famsDiv.innerHTML) {
            var fmax = Math.max.apply(null, order.families.map(function(f){return f.count;}));
            famsDiv.innerHTML = order.families.map(function(f){
              var fpct = (f.count / fmax * 100).toFixed(1);
              return (
                '<div style="display:grid;grid-template-columns:200px 1fr 60px;align-items:center;gap:0.4rem;height:14px;font-size:0.78rem;">' +
                  '<span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="'+f.name+'">'+f.name+'</span>' +
                  '<span style="display:inline-block;height:7px;background:var(--kingdom-'+(order.kingdom||'plant')+');width:'+fpct+'%;border-radius:1px;opacity:0.7;"></span>' +
                  '<span style="text-align:right;color:var(--text-muted);font-variant-numeric:tabular-nums;">'+f.count.toLocaleString()+'</span>' +
                '</div>'
              );
            }).join('');
          }
          famsDiv.style.display = '';
          if (caret) caret.style.transform = 'rotate(90deg)';
        } else {
          famsDiv.style.display = 'none';
          if (caret) caret.style.transform = 'rotate(0deg)';
        }
      });
    });
  }
})();
</script>
