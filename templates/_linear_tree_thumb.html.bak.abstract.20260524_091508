{# Linear-tree thumbnail: top-N orders as horizontal bars.
   Expects `linear_tree` context var: list of {name, kingdom, count} dicts. #}
{% if linear_tree %}
<a href="#cladogram-panel" class="linear-tree-thumb-wrap" style="display:flex;flex-direction:column;gap:0.15rem;font-size:0.72rem;line-height:1.1;text-decoration:none;color:inherit;width:180px;flex-shrink:0;margin-left:auto;">
  <div style="font-size:0.72rem;color:var(--text-muted);margin-bottom:0.2rem;font-weight:500;">Top orders ({{ linear_tree|length }})</div>
  {% set max_count = linear_tree[0].count %}
  {% for row in linear_tree %}
    {% set width_pct = (row.count / max_count * 100) %}
    <div style="display:grid;grid-template-columns:65px 1fr 30px;align-items:center;gap:0.3rem;height:13px;">
      <span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:0.7rem;" title="{{ row.name }}">{{ row.name }}</span>
      <span style="display:inline-block;height:8px;background:var(--kingdom-{{ row.kingdom or 'plant' }});width:{{ "%.1f"|format(width_pct) }}%;border-radius:1px;"></span>
      <span style="text-align:right;color:var(--text-muted);font-size:0.65rem;font-variant-numeric:tabular-nums;">{{ "{:,}".format(row.count) }}</span>
    </div>
  {% endfor %}
  <div style="font-size:0.65rem;color:var(--accent);font-style:italic;margin-top:0.2rem;text-align:center;">(click to expand tree)</div>
</a>
{% endif %}
